{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:schema:v1.8:data-use-grant",
  "title": "DataUseGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "grantor_domain",
    "grantee_domain",
    "data_owner",
    "purpose",
    "data_categories",
    "allowed_operations",
    "prohibited_operations",
    "scope",
    "policy_version",
    "issued_at",
    "expires_at",
    "revocation_ref",
    "approval_refs",
    "signature"
  ],
  "properties": {
    "grant_id": {
      "type": "string"
    },
    "grantor_domain": {
      "type": "string"
    },
    "grantee_domain": {
      "type": "string"
    },
    "data_owner": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 8
    },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "enum": [
          "READ",
          "AGGREGATE",
          "TRANSFORM",
          "DERIVE",
          "EXPORT",
          "DELETE_ON_REQUEST"
        ]
      }
    },
    "prohibited_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "resource_refs",
        "subject_refs",
        "geographic_scope"
      ],
      "properties": {
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geographic_scope": {
          "type": "string"
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_ref": {
      "type": "string"
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
