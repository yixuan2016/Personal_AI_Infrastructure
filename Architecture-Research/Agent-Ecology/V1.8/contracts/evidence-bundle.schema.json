{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-ecology/v1.8/evidence-bundle.schema.json",
  "title": "EvidenceBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "proposal_id",
    "evidence_level",
    "artifacts",
    "evaluation_context",
    "limitations",
    "issuer",
    "signature"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "digest",
          "kind"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "evaluation_context": {
      "type": "object",
      "required": [
        "environment",
        "model_versions",
        "dataset_versions",
        "baseline"
      ],
      "properties": {
        "environment": {
          "type": "string"
        },
        "model_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataset_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "results": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuer": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
