{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-ecology/v1.8/capability-attestation.schema.json",
  "title": "CapabilityAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "owner_domain",
    "operator_identity",
    "input_schema",
    "output_schema",
    "allowed_actions",
    "evidence_refs",
    "valid_from",
    "valid_until",
    "signature"
  ],
  "properties": {
    "capability_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "owner_domain": {
      "type": "string"
    },
    "operator_identity": {
      "type": "string"
    },
    "input_schema": {
      "type": "string"
    },
    "output_schema": {
      "type": "string"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_uri": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
