{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:v1.9:capability-advertisement-candidate",
  "title": "CapabilityAdvertisementCandidate",
  "description": "Owner-issued, time-bounded capability statement for discovery only; it does not grant invocation authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "advertisementId",
    "domainId",
    "capabilityOwner",
    "capability",
    "lifecycleState",
    "exportPolicy",
    "evidenceRefs",
    "freshness",
    "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.9.0-candidate" },
    "advertisementId": { "type": "string", "minLength": 1 },
    "domainId": { "type": "string", "minLength": 3 },
    "capabilityOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerRef", "signerPrincipal"],
      "properties": {
        "ownerRef": { "type": "string", "minLength": 1 },
        "signerPrincipal": { "type": "string", "minLength": 1 },
        "workloadIdentityRef": { "type": "string" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "version",
        "ontologyRefs",
        "inputSchemaRef",
        "outputSchemaRef",
        "supportedProtocols",
        "allowedActions",
        "sideEffectClass",
        "riskClass"
      ],
      "properties": {
        "capabilityId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "ontologyRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ontologyId", "version", "conceptId"],
            "properties": {
              "ontologyId": { "type": "string" },
              "version": { "type": "string" },
              "conceptId": { "type": "string" },
              "mappingEvidenceRef": { "type": "string" }
            }
          }
        },
        "inputSchemaRef": { "type": "string", "format": "uri-reference" },
        "outputSchemaRef": { "type": "string", "format": "uri-reference" },
        "contractVersion": { "type": "string" },
        "supportedProtocols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "version"],
            "properties": {
              "protocol": { "enum": ["A2A", "MCP", "HTTPS_JSON", "GRPC"] },
              "version": { "type": "string" },
              "endpointRef": { "type": "string", "format": "uri-reference" },
              "authenticationSchemes": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "sideEffectClass": {
          "enum": [
            "NONE",
            "READ_ONLY",
            "REVERSIBLE_WRITE",
            "COMPENSATABLE_WRITE",
            "IRREVERSIBLE_OR_EXTERNAL_COMMIT"
          ]
        },
        "riskClass": { "enum": ["R0", "R1", "R2", "R3"] },
        "dataClasses": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "purposeRefs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "residencyConstraints": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "resourceConstraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxLatencyMs": { "type": "integer", "minimum": 0 },
            "maxCost": { "type": "number", "minimum": 0 },
            "costUnit": { "type": "string" },
            "regionAllowlist": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "lifecycleState": {
      "enum": [
        "PUBLISHED",
        "VERIFIED",
        "ACTIVE",
        "DEGRADED",
        "SUSPENDED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "exportPolicy": {
      "enum": [
        "PUBLIC",
        "FEDERATION_MEMBERS",
        "NAMED_DOMAINS",
        "PRIVATE_REFERENCE_ONLY"
      ]
    },
    "visibleToDomains": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "format": "uri-reference" },
      "uniqueItems": true
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt", "observedAt", "expiresAt", "sourceWatermark", "revocationEpoch"],
      "properties": {
        "issuedAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "sourceWatermark": { "type": "integer", "minimum": 0 },
        "revocationEpoch": { "type": "integer", "minimum": 0 }
      }
    },
    "availabilityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt", "expiresAt", "authorityRef", "notAuthorization"],
      "properties": {
        "status": { "enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE", "UNKNOWN"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "authorityRef": { "type": "string" },
        "notAuthorization": { "const": true }
      }
    },
    "revocationRef": { "type": "string", "format": "uri-reference" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerDomain", "signerPrincipal", "keyId", "algorithm", "payloadDigest", "signatureRef"],
      "properties": {
        "signerDomain": { "type": "string" },
        "signerPrincipal": { "type": "string" },
        "keyId": { "type": "string" },
        "algorithm": { "type": "string" },
        "payloadDigest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "signatureRef": { "type": "string", "format": "uri-reference" }
      }
    }
  }
}