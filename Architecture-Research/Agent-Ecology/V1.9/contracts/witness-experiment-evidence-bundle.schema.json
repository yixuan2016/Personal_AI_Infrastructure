{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:v1.9:witness-experiment-evidence-bundle-candidate",
  "title": "AgentEcologyWitnessExperimentEvidenceBundleCandidate",
  "description": "Evidence index for reproducible model checking and synthetic fault experiments. Contains references and digests, never secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "runId",
    "scenarioDigest",
    "modelDigest",
    "result",
    "evidenceItems",
    "createdAt",
    "notProduction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "modelDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "result": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "evidenceItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "uri",
          "digest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "INPUT",
              "TRACE",
              "COUNTEREXAMPLE",
              "MODEL_REPORT",
              "SIMULATOR_LOG",
              "HISTORY",
              "CHECKER_REPORT",
              "SCREENSHOT",
              "REVIEW"
            ]
          },
          "uri": {
            "type": "string",
            "format": "uri-reference"
          },
          "digest": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "independentReviewer": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "notProduction": {
      "const": true
    }
  }
}
