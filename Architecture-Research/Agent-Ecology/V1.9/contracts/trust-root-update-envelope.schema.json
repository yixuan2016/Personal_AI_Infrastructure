{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:v1.9:trust-root-update-envelope-candidate",
  "title": "AgentEcologyTrustRootUpdateEnvelopeCandidate",
  "description": "Candidate versioned trust root update. Normal rotation requires previous-root and new-root thresholds; emergency recovery uses pre-registered out-of-band anchors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rootId",
    "rootVersion",
    "previousRootDigest",
    "issuedAt",
    "expiresAt",
    "keys",
    "rootThreshold",
    "updateMode",
    "oldRootSignatures",
    "newRootSignatures",
    "recoveryAnchorRefs",
    "rootDigest",
    "notAuthorization"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "rootId": {
      "type": "string",
      "minLength": 3
    },
    "rootVersion": {
      "type": "integer",
      "minimum": 1
    },
    "previousRootDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "fingerprint",
          "algorithm",
          "role",
          "keyEpoch",
          "custodyDomainId",
          "status"
        ],
        "properties": {
          "keyId": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "algorithm": {
            "enum": [
              "Ed25519",
              "ML-DSA-44",
              "ECDSA-P256",
              "RSA-3072",
              "OTHER_APPROVED"
            ]
          },
          "role": {
            "enum": [
              "ROOT",
              "WITNESS_REGISTRY",
              "QUORUM_POLICY",
              "EMERGENCY_RECOVERY"
            ]
          },
          "keyEpoch": {
            "type": "integer",
            "minimum": 1
          },
          "custodyDomainId": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "ACTIVE",
              "PREPARED",
              "REVOKED",
              "RETIRED"
            ]
          }
        }
      }
    },
    "rootThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oldThreshold",
        "newThreshold",
        "minimumDistinctCustodyDomains"
      ],
      "properties": {
        "oldThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "newThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "minimumDistinctCustodyDomains": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "updateMode": {
      "enum": [
        "NORMAL_DUAL_THRESHOLD",
        "EMERGENCY_OUT_OF_BAND_RECOVERY"
      ]
    },
    "oldRootSignatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "signature",
          "signedAt"
        ],
        "properties": {
          "keyId": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "minLength": 20
          },
          "signedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "newRootSignatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "signature",
          "signedAt"
        ],
        "properties": {
          "keyId": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "minLength": 20
          },
          "signedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "recoveryAnchorRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "peerBindingAcceptanceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "rootDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "notAuthorization": {
      "const": true
    }
  }
}
