{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:v1.9:witness-recovery-snapshot-manifest-candidate",
  "title": "AgentEcologyWitnessRecoverySnapshotManifestCandidate",
  "description": "Recovery metadata manifest. A valid signature proves integrity/origin, not freshness; reconciliation with external witness checkpoints is mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "witnessId",
    "snapshotGeneration",
    "stateSequence",
    "previousSnapshotDigest",
    "logStates",
    "trustRootVersion",
    "registryVersion",
    "policyVersion",
    "membershipEpoch",
    "keyEpoch",
    "walWatermark",
    "capturedAt",
    "storageFailureDomain",
    "encryptionKeyRef",
    "snapshotDigest",
    "signerKeyId",
    "signature",
    "notAuthorization"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "witnessId": {
      "type": "string",
      "minLength": 3
    },
    "snapshotGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "stateSequence": {
      "type": "integer",
      "minimum": 1
    },
    "previousSnapshotDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "logStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logOrigin",
          "latestCheckpointDigest",
          "treeSize",
          "rootHash",
          "lastAcceptedAt"
        ],
        "properties": {
          "logOrigin": {
            "type": "string",
            "minLength": 3
          },
          "latestCheckpointDigest": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "treeSize": {
            "type": "integer",
            "minimum": 0
          },
          "rootHash": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "lastAcceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "consistencyProofRef": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      }
    },
    "trustRootVersion": {
      "type": "integer",
      "minimum": 1
    },
    "registryVersion": {
      "type": "integer",
      "minimum": 1
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "membershipEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "keyEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "walWatermark": {
      "type": "integer",
      "minimum": 0
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "storageFailureDomain": {
      "type": "string",
      "minLength": 3
    },
    "backupReplicaRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "encryptionKeyRef": {
      "type": "string",
      "minLength": 1
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "signerKeyId": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 20
    },
    "externalWitnessReceiptRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "restoreAssessment": {
      "enum": [
        "NOT_RESTORED",
        "PENDING_RECONCILIATION",
        "RECONCILED",
        "QUARANTINED"
      ]
    },
    "notAuthorization": {
      "const": true
    }
  }
}
