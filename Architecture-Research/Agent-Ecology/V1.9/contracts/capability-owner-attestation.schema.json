{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-ecology:v1.9:capability-owner-attestation-candidate",
  "title": "CapabilityOwnerAttestationCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestationId",
    "issuerDomainId",
    "issuerPrincipalId",
    "ownerId",
    "capabilityId",
    "capabilityVersion",
    "payloadDigest",
    "canonicalization",
    "purpose",
    "audiences",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "keyId",
    "keyEpoch",
    "algorithm",
    "jti",
    "ownerDelegationGrantDigest",
    "signatureType",
    "compactJws",
    "notAuthorization"
  ],
  "properties": {
    "attestationId": {
      "type": "string"
    },
    "issuerDomainId": {
      "type": "string"
    },
    "issuerPrincipalId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "capabilityId": {
      "type": "string"
    },
    "capabilityVersion": {
      "type": "string"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "canonicalization": {
      "const": "RFC8785-JCS"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri-reference"
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyId": {
      "type": "string"
    },
    "keyEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "algorithm": {
      "enum": [
        "ES256",
        "EdDSA",
        "PS256"
      ]
    },
    "jti": {
      "type": "string",
      "minLength": 16
    },
    "ownerDelegationGrantDigest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "signatureType": {
      "const": "JWS"
    },
    "compactJws": {
      "type": "string",
      "minLength": 20
    },
    "notAuthorization": {
      "const": true
    }
  }
}
