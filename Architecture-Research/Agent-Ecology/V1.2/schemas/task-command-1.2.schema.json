{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ecology.example/schemas/task-command-1.2.schema.json",
  "title": "Task Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "command",
    "expected_version",
    "actor_id",
    "purpose",
    "idempotency_key"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command": {
      "enum": [
        "publish",
        "claim",
        "heartbeat",
        "release",
        "start",
        "submit",
        "accept",
        "reject",
        "cancel",
        "block",
        "unblock"
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "lease_id": {
      "type": "string"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "lease_ttl_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_code": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 2048
    }
  }
}