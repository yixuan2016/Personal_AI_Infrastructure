{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/aee-ascp/g2-04/activationbarrierrecord.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "ActivationBarrierRecord",
  "required": [
    "transaction_id",
    "barrier_epoch",
    "required_sites",
    "commit_receipt_digests",
    "revocation_checkpoint",
    "expires_at",
    "signature_ref"
  ],
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "barrier_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "required_sites": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "commit_receipt_digests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "revocation_checkpoint": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_ref": {
      "type": "string",
      "format": "uri-reference"
    }
  }
}
