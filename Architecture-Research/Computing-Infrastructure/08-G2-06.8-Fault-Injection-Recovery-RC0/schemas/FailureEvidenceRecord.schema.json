{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/pal-base/g2-06.8/failure-evidence-record.schema.json",
  "title": "FailureEvidenceRecord",
  "description": "G2-06.8 RC0 candidate. Auditable record for an authorized fault-injection and recovery exercise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_run_id",
    "scenario_id",
    "environment",
    "scope",
    "started_at",
    "ended_at",
    "injection",
    "expected_outcome",
    "observed_outcome",
    "result",
    "participants",
    "baseline_refs",
    "evidence_refs",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0-RC0" },
    "test_run_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "enum": ["isolated_lab", "staging", "approved_production_window"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "sites", "fault_domains"],
      "properties": {
        "regions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "sites": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "fault_domains": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fault_type", "method", "approved", "stop_conditions"],
      "properties": {
        "fault_type": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean" },
        "approval_refs": { "type": "array", "items": { "type": "string", "format": "uri-reference" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "expected_outcome": { "type": "string", "minLength": 1 },
    "observed_outcome": { "type": "string", "minLength": 1 },
    "result": { "type": "string", "enum": ["passed", "failed", "blocked", "manual_hold", "quarantined", "aborted"] },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detection_seconds": { "type": "number", "minimum": 0 },
        "containment_seconds": { "type": "number", "minimum": 0 },
        "recovery_seconds": { "type": "number", "minimum": 0 },
        "revocation_convergence_seconds": { "type": "number", "minimum": 0 },
        "measurement_method_ref": { "type": "string", "format": "uri-reference" }
      }
    },
    "authority_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner_ref", "owner_epoch", "sequence_no"],
        "properties": {
          "owner_ref": { "type": "string", "format": "uri-reference" },
          "owner_epoch": { "type": "integer", "minimum": 0 },
          "sequence_no": { "type": "integer", "minimum": 0 },
          "region_epoch": { "type": "integer", "minimum": 0 },
          "lease_ref": { "type": "string", "format": "uri-reference" },
          "fencing_token_ref": { "type": "string", "format": "uri-reference" },
          "revocation_watermark_ref": { "type": "string", "format": "uri-reference" }
        }
      }
    },
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injector", "observer", "recovery_owner", "independent_witness"],
      "properties": {
        "injector": { "type": "string", "minLength": 1 },
        "observer": { "type": "string", "minLength": 1 },
        "recovery_owner": { "type": "string", "minLength": 1 },
        "independent_witness": { "type": "string", "minLength": 1 },
        "approvers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "baseline_refs": { "type": "array", "items": { "type": "string", "format": "uri-reference" } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "format": "uri-reference" }, "minItems": 1 },
    "deviation_refs": { "type": "array", "items": { "type": "string", "format": "uri-reference" } },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "signature_ref": { "type": "string", "format": "uri-reference" }
  }
}
